[Unit]
Description=LAC historical market-day collection

[Service]
Type=simple
WorkingDirectory=/home/admin/web/python
EnvironmentFile=/home/admin/web/.env
EnvironmentFile=-/home/admin/web/.env.local
ExecStart=/home/admin/web/python/.venv/bin/python -m m_historical.all_runtime
Restart=no
KillMode=mixed
TimeoutStopSec=infinity
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
